rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFieldMutable(fieldName) {
      return fieldName in request.resource.data
        && (!(fieldName in resource.data)
            || resource.data[fieldName] == request.resource.data[fieldName]);
    }

    function fieldsMatch(expected, actual) {
      return expected.keys().hasAll(actual.keys());
    }

    function isValidWorkspaceMember(workspaceId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
    }

    // =========================================================
    // INVITES COLLECTION
    // =========================================================
    match /invites/{inviteCode} {

      // CREATE: authenticated user creates invite code
      allow create: if isAuthenticated()
        && request.resource.data.code is string
        && request.resource.data.code.size() == 8
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorEmail is string
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.status == 'active'
        && request.resource.data.acceptedBy == null;

      // READ: creator can read their own invite
      allow read: if isAuthenticated()
        && resource.data.creatorId == request.auth.uid;

      // UPDATE: accept invite — only allowed to transition status to 'accepted'
      allow update: if isAuthenticated()
        && resource.data.creatorId != request.auth.uid
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.code == resource.data.code
        && request.resource.data.creatorEmail == resource.data.creatorEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;

      // DELETE: only the creator can revoke (mark as expired)
      allow delete: if false;

      // Deny everything else
      allow list: if false;
    }

    // =========================================================
    // WORKSPACES COLLECTION
    // =========================================================
    match /workspaces/{workspaceId} {

      // CREATE: authenticated user creates workspace with themselves as sole initial member
      allow create: if isAuthenticated()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is number;

      // READ: only workspace members
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.memberIds;

      // UPDATE: only members can update, memberIds is IMMUTABLE after creation
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.memberIds
        && isFieldMutable('memberIds')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.memberIds == resource.data.memberIds;

      // DELETE: only the creator can delete
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;

      // =========================================================
      // VAULTS SUBCOLLECTION
      // =========================================================
      match /vaults/{vaultId} {

        // CREATE: only workspace members can create vaults
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 20
          && request.resource.data.createdAt is number
          && !request.resource.data.keys().hasAny(['balance']);

        // READ: only workspace members
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;

        // UPDATE: only workspace members can update, balance is server-derived
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 20
          && !request.resource.data.keys().hasAny(['balance']);

        // DELETE: only workspace members can delete
        allow delete: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;

        // =========================================================
        // TRANSACTIONS SUBCOLLECTION
        // =========================================================
        match /transactions/{transactionId} {

          // CREATE: only workspace members can create transactions
          allow create: if isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds
            && request.resource.data.vaultId == vaultId
            && request.resource.data.type in ['INFLOW', 'OUTFLOW']
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 500
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt is number
            && request.resource.data.deleted == false;

          // READ: only workspace members
          allow read: if isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;

          // UPDATE: soft delete only — set deleted=true
          allow update: if isAuthenticated()
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds
            && request.resource.data.deleted == true
            && resource.data.deleted == false
            && request.resource.data.vaultId == resource.data.vaultId
            && request.resource.data.type == resource.data.type
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.description == resource.data.description
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt;

          // DELETE: HARD DELETE IS FORBIDDEN — use soft delete only
          allow delete: if false;
        }
      }
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
